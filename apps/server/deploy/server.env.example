HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgresql://pimesh:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/pimesh

# Directory requires HTTPS and a SHA-256 hash of username:random-password.
DIRECTORY_ENABLED=false
# DIRECTORY_ACCESS_HASH=REPLACE_WITH_SHA256_HEX
# TLS_CERT_FILE=/etc/pimesh/tls/server.crt
# TLS_KEY_FILE=/etc/pimesh/tls/server.key

# Enable only after applying 002-invite-auth; use separate administrator credentials.
AUTH_ENABLED=false
# PUBLIC_ORIGIN=https://your-domain.example
# INVITE_ADMIN_HASH=REPLACE_WITH_SHA256_HEX
